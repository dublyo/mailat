{
  "name": "mailat",
  "version": "0.1.0",
  "private": true,
  "description": "All-in-one email platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/dublyo/mailat"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @mailat/api dev",
    "dev:web": "pnpm --filter @mailat/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "ioredis": "^5.4.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
