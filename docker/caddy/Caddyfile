# ===================
# Mailat - Caddy Configuration
# ===================
# Automatic HTTPS with Let's Encrypt
#
# Configure domains via environment variables:
#   DOMAIN         - Main app domain (e.g., mailat.example.com)
#   API_DOMAIN     - API subdomain (e.g., api.example.com)
#   MAIL_DOMAIN    - Legacy Stalwart admin UI (legacy profile only)

# Main web app
{$DOMAIN:localhost} {
    # Proxy API requests
    handle /api/* {
        reverse_proxy api:8000
    }

    # Serve static files and SPA
    handle {
        reverse_proxy web:80
    }

    # Security headers. Framing and CSP are owned by the web container's nginx,
    # which lets only /subscribe/ be embedded; a frame header here would break it.
    # "?" only fills a header the upstream did not set (keeps /subscribe/'s
    # stricter no-referrer).
    header {
        ?X-Content-Type-Options "nosniff"
        ?Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Compression
    encode gzip zstd
}

# API subdomain (optional - for direct API access)
{$API_DOMAIN:api.localhost} {
    reverse_proxy api:8000

    # CORS is answered by the API itself (WEB_URL + CORS_ORIGINS allowlist).
    header {
        X-Content-Type-Options "nosniff"
    }

    encode gzip zstd
}

# Stalwart mail server admin UI: legacy profile only. The default EMAIL_PROVIDER
# is ses and needs no Stalwart; drop this block when the legacy profile is off.
{$MAIL_DOMAIN:mail.localhost} {
    reverse_proxy stalwart:8080
}
