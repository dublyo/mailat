# Rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf.
# Only MAILAT_* variables are substituted (NGINX_ENVSUBST_FILTER in the
# Dockerfile), so nginx's own $variables below are left untouched.

# SPA Content-Security-Policy without frame-ancestors, which differs per route.
# - style-src 'unsafe-inline': TipTap and vue-flow inject styles, and the
#   message iframe's srcdoc <style> inherits this policy.
# - img-src https: lets "Show images" work inside the inherited srcdoc policy;
#   the per-message meta CSP still blocks remote images by default.
# - blob: serves inline CID images. Google Fonts are loaded by index.html.
# - MAILAT_CSP_CONNECT_SRC adds API/SSE origins when VITE_API_URL points elsewhere.
map $host $mailat_csp_base {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' ${MAILAT_CSP_CONNECT_SRC}; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'";
}

# Only forward a WebSocket upgrade when the client asked for one.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Baseline for locations without their own add_header (/api/, /docs/,
    # /nginx-health). SPA locations replace these via the snippet.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    # API proxy - forward to backend (no SPA CSP; the API sets its own headers)
    location /api/ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Serve the embedded API contract and Swagger UI instead of the SPA fallback.
    location /docs/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static assets caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/spa-headers.conf;
    }

    # Only the standalone public signup route may be embedded on another site.
    # Use index.html as the location index (not an internal redirect to /), so
    # private SPA routes retain their SAMEORIGIN header.
    location = /subscribe/confirm {
        try_files /index.html =404;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "$mailat_csp_base; frame-ancestors 'none'" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /subscribe/ {
        try_files /index.html =404;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "$mailat_csp_base; frame-ancestors *" always;
        add_header Cache-Control "no-store" always;
    }

    # Container liveness. Exact match so the SPA's own /health page still loads.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "OK";
    }

    # SPA routing - fallback to index.html
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/spa-headers.conf;
    }
}
