# Mailat production: copy to .env beside docker-compose.prod.yml.
# These are placeholders. Supply real values securely through your deployment environment.
# Image repositories remain ghcr.io/dublyo/mailat-api and ghcr.io/dublyo/mailat-web.
# Prefer a tested immutable release tag for VERSION instead of latest.
VERSION=latest

# Caddy serves browser and /api on the same HTTPS origin.
DOMAIN=mail.example.com
API_URL=https://mail.example.com
WEB_URL=https://mail.example.com
# Extra browser origins allowed to call the API besides WEB_URL (comma-separated https://host[:port]).
# Leave empty when the app and /api share one origin.
CORS_ORIGINS=
# Proxies whose X-Forwarded-For is trusted for client IPs. Must include the reverse-proxy network;
# docker-compose.prod.yml defaults to loopback plus the private ranges when this is unset.
#TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
APP_DOMAIN=mail.example.com
APP_NAME=Mailat
# Optional Caddy virtual hosts. Leave localhost defaults unless intentionally exposing them.
API_DOMAIN=api.localhost
MAIL_DOMAIN=mail.localhost

DATABASE_URL=postgresql://replace-user:replace-password@db.example.com:5432/mailat?sslmode=require
REDIS_URL=rediss://:replace-password@redis.example.com:6379

# Generate two different random values of at least 32 bytes, e.g. openssl rand -hex 32.
# The API refuses to start with the placeholders below, short values, or equal values.
# Keep ENCRYPTION_KEY stable across upgrades and restore it with database backups.
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Session lifetime: 7d, 30d or a duration such as 168h (1h to 90d).
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-a-separate-long-random-encryption-key

# ses (default) or smtp.
EMAIL_PROVIDER=ses
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key
SES_CONFIGURATION_SET=
# Campaign sender: messages per second (0 = 80% of the SES MaxSendRate) and parallel sends (1-16).
CAMPAIGN_MAX_SEND_RATE=0
CAMPAIGN_SEND_CONCURRENCY=4
# Auto-replies one rule may send per UTC day (1-10000).
AUTO_REPLY_DAILY_LIMIT=200

WORKER_ENABLED=true
AUTO_MIGRATE=true
DISABLE_APP_LIMITS=true
DEFAULT_MAX_DOMAINS=0
DEFAULT_MONTHLY_EMAIL_LIMIT=0
DEFAULT_MAX_IDENTITIES=0
DEFAULT_MAX_CONTACTS=0

# Optional only: docker compose -f docker-compose.prod.yml --profile stalwart up -d
# SES mode does not need Stalwart or a separate Stalwart database.
STALWART_URL=http://stalwart:8080
STALWART_DATABASE_URL=
STALWART_ADMIN_TOKEN=
SMTP_HOST=stalwart
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Legacy internal Stalwart configuration; configure valid TLS before external SMTP use.
SMTP_TLS=false
