{
  "name": "@mailat/sdk",
  "version": "0.2.0",
  "description": "Official JavaScript/TypeScript SDK for the self-hosted Mailat API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "email",
    "transactional",
    "email-api",
    "mailat",
    "sdk"
  ],
  "author": "Mailat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dublyo/mailat",
    "directory": "packages/sdk-js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
