# Mailat local API + Vue development with hosted PostgreSQL and Redis.
# Copy to .env in the repository root. Never commit real secrets.
# Run the API from apps/api so its ../../.env lookup resolves correctly.
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Extra browser origins allowed to call the API besides WEB_URL (comma-separated https://host[:port]).
CORS_ORIGINS=
# Proxies whose X-Forwarded-For is trusted for client IPs (comma-separated CIDRs; default loopback only).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
APP_DOMAIN=localhost
APP_NAME=Mailat

DATABASE_URL=postgresql://replace-user:replace-password@db.example.com:5432/mailat?sslmode=require
REDIS_URL=rediss://:replace-password@redis.example.com:6379

# Generate two different random values of at least 32 bytes, e.g. openssl rand -hex 32.
# The API refuses to start with the placeholders below.
# Keep ENCRYPTION_KEY stable across upgrades and restore it with database backups.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-a-separate-long-random-encryption-key

EMAIL_PROVIDER=ses
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key
# Optional existing SES configuration set; configure its SNS event destination separately.
SES_CONFIGURATION_SET=

WORKER_ENABLED=true
AUTO_MIGRATE=true
# No application plan caps by default. AWS quotas and message safety limits still apply.
DISABLE_APP_LIMITS=true
DEFAULT_MAX_DOMAINS=0
DEFAULT_MONTHLY_EMAIL_LIMIT=0
DEFAULT_MAX_IDENTITIES=0
DEFAULT_MAX_CONTACTS=0

# Optional legacy SMTP/JMAP backend; unnecessary for EMAIL_PROVIDER=ses.
STALWART_URL=http://localhost:8080
STALWART_ADMIN_TOKEN=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Optional legacy search integration; SES inbox search uses PostgreSQL.
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=
