{
  "id": "mailatSendV1",
  "name": "Mailat - safe single and partial batch",
  "nodes": [
    {
      "id": "f91df046-1011-5dd3-b78f-102798639935",
      "name": "Run deliberately",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "1399fbf5-025e-50f3-b2df-1febf452d5c2",
      "name": "Stable business requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ],
      "parameters": {
        "jsCode": "const from=$env.MAILAT_FROM, to=$env.MAILAT_TO, singleKey=$env.MAILAT_SEND_KEY, batchKey=$env.MAILAT_BATCH_KEY;\nif (!from || !to || !singleKey || !batchKey) throw new Error('Set MAILAT_FROM, MAILAT_TO and stable business keys MAILAT_SEND_KEY / MAILAT_BATCH_KEY before running.');\nconst attachment={name:'automation.txt',type:'text/plain',content:Buffer.from('Automation attachment').toString('base64')};\nreturn [{json:{singleKey,batchKey,single:{from,to:[to],subject:'Mailat automation example',text:'Single send with attachment',attachments:[attachment]},batch:{emails:[{from,to:[to],subject:'Batch one',text:'First batch item',attachments:[attachment]},{from,to:[to],subject:'Batch two',text:'Second batch item'},{from,to:['invalid-address'],subject:'Expected validation failure',text:'This item intentionally fails validation.'}]}}}];"
      }
    },
    {
      "id": "e4765ae7-0714-5793-9deb-7d35eac2e9da",
      "name": "Submit single",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MAILAT_API_URL + '/emails' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.single }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.singleKey }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "MAILAT_API_CREDENTIAL",
          "name": "Mailat API token"
        }
      }
    },
    {
      "id": "f026489f-9c59-5db2-820c-805c017d650e",
      "name": "Read single status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MAILAT_API_URL + '/emails/' + $json.data.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "MAILAT_API_CREDENTIAL",
          "name": "Mailat API token"
        }
      }
    },
    {
      "id": "d6712340-b029-5d05-90f7-37fb34187a07",
      "name": "Single outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "const d=$json.data; const status=d.status; if(!['queued','sending','sent','delivered','failed','unknown','bounced','complained','cancelled'].includes(status)) throw new Error('Unrecognized status'); return [{json:{messageUuid:d.id||d.uuid,status,nextAction:['queued','sending'].includes(status)?'poll same UUID':status==='unknown'?'inspect; do not resend':'retain receipt'}}];"
      }
    },
    {
      "id": "fbc9d147-1498-526d-97df-96144471a241",
      "name": "Submit partial batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MAILAT_API_URL + '/emails/batch' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $('Stable business requests').first().json.batch }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Stable business requests').first().json.batchKey }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "MAILAT_API_CREDENTIAL",
          "name": "Mailat API token"
        }
      }
    },
    {
      "id": "2bd97b64-3368-57df-9058-621314d7ad22",
      "name": "Classify each batch item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        250
      ],
      "parameters": {
        "jsCode": "return $json.data.results.map((r,index)=>({json:{...r,index,nextAction:r.status==='unknown'?'inspect existing UUID; keep original batch key':r.status==='failed'?'fix only for a deliberate new request/key':'poll same UUID'}}));"
      }
    },
    {
      "id": "a1da9f5a-c9e4-59d5-9ca5-5ef1aa47bc01",
      "name": "Has receipt UUID",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        250,
        250
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b91a87d3-4c4d-4771-9de7-22e729a62a8b",
              "leftValue": "={{ Boolean($json.id) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "17c0a5d6-06ba-51c2-8b93-9687974f837e",
      "name": "Read batch item status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        250
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MAILAT_API_URL + '/emails/' + $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "MAILAT_API_CREDENTIAL",
          "name": "Mailat API token"
        }
      }
    },
    {
      "id": "aabac500-92cc-5648-ac29-0a4a71bb1f84",
      "name": "Validation failure retained",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        250
      ],
      "parameters": {
        "jsCode": "return $input.all();"
      }
    }
  ],
  "connections": {
    "Run deliberately": {
      "main": [
        [
          {
            "node": "Stable business requests",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stable business requests": {
      "main": [
        [
          {
            "node": "Submit single",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit single": {
      "main": [
        [
          {
            "node": "Read single status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read single status": {
      "main": [
        [
          {
            "node": "Single outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Single outcome": {
      "main": [
        [
          {
            "node": "Submit partial batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit partial batch": {
      "main": [
        [
          {
            "node": "Classify each batch item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify each batch item": {
      "main": [
        [
          {
            "node": "Has receipt UUID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has receipt UUID": {
      "main": [
        [
          {
            "node": "Read batch item status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Validation failure retained",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 240,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  }
}
