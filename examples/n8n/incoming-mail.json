        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {emailUuids:[$('Verify exact body').first().json.event.data.messageUuid],folder:'archive'} }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "MAILAT_API_CREDENTIAL",
          "name": "Mailat API token"
        }
      }
    },
    {
      "id": "9360430c-ec56-526c-b906-6529b5007237",
      "name": "Complete event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        750,
        500
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE mailat_n8n_events SET completed_at=NOW(),lease_until=NULL WHERE event_id=$1 AND lease_owner=$2 RETURNING event_id;",
        "options": {
          "queryReplacement": "={{ [$('Verify exact body').first().json.event.id,$('Verify exact body').first().json.leaseOwner] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "MAILAT_STATE_CREDENTIAL",
          "name": "Mailat automation state"
        }
      }
    },
    {
      "id": "f3119bf5-5d8f-51c5-9266-3097ef18423c",
      "name": "Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1000,
        500
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {accepted:true} }}",
        "options": {
          "responseCode": "={{ 200 }}"
