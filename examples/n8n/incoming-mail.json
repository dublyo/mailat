      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "817779d5-2062-4948-a064-501eb0961730",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f7b9a571-b94e-4961-aeb0-5cd62d5ba6bb",
      "name": "Reject unauthenticated",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        750,
        -250
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {accepted:false} }}",
        "options": {
          "responseCode": 401
        }
      }
    }
